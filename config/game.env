# Yakuza (USA, Amusement Vision / Sega, SLUS-213.48, 2006).
# SLUS_213.48 is a small loader; the game is MAIN.BIN, a CodeWarrior MWo3 overlay loaded at 0x100000. More MWo3
# modules (Media4\Module\game.bin, minigames) come from the CRI ROFS archives OGRE*.CVM, whose ISO9660 images are
# scrambled: they cannot be extracted ahead, the game reads them by sector (the runtime serves raw LBN reads from
# the ISO) and the modules are captured from RAM when loaded.
GAME=yakuza
ELF_NAME=SLUS_213.48
ISO_NAME="Yakuza (USA).iso"
ISO="$ROOT/$ISO_NAME"
MFA=""
OVERLAY_GLOB="MAIN.BIN"
# Common base (recomp-main) since 2026-11-13; the old per-game tree stays at ../PS2Recomp-yakuza (backup).
PS2RECOMP="${PS2RECOMP_OVERRIDE:-$HOME/PS2/PS2Recomp-main}"
BUILD="$PS2RECOMP/build"
export PS2X_VU1_NATIVE="${PS2X_VU1_NATIVE:-1}"
# MAIN.BIN's header says 0x100000 (header version 0); SLUS_213.48 copies the file, unrelocated, to 0x167C80.
export MWO3_LOAD="main.bin=0x167c80,MAIN.BIN=0x167c80"
export MWO3_TEXT_ALL="main.bin,ogre4_02.bin,ogre4_03.bin,ogre4_04.bin,ogre4_05.bin,ogre4_06.bin,ogre4_07.bin,ogre4_08.bin,ogre4_09.bin,ogre4_10.bin,ogre4_11.bin,ogre4_12.bin"
export DEV_BUILD="${DEV_BUILD:-1}"   # -O1 generated code, 8 jobs: bring-up builds
export OVERLAY_SCAN="OGRE4.CVM"   # /MEDIA4/MODULE/*.bin: game, cabaret, blackjack... (all load at 0x62b300)

# city map (common/tools/city.sh): the game code is the ovl_main overlay
CITY_OVERLAY="out/overlays/ovl_main.elf ovl_main"
